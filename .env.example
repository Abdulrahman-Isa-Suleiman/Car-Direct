NEXT_PUBLIC_SITE_URL=             # your custom domain, e.g. https://carsdirect.ng. Optional on Vercel (detected automatically)
NEXT_PUBLIC_WHATSAPP=             # WhatsApp number in international form, e.g. 2348030000000
NEXT_PUBLIC_HERO_IMAGE=           # optional homepage hero photo URL
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only, never expose
PAYSTACK_SECRET_KEY=              # sk_test_... ; webhook URL: /api/payments/paystack/webhook
RESEND_API_KEY=                   # receipts; leave empty to skip emails
EMAIL_FROM=                       # e.g. Cars Direct <orders@carsdirect.ng>
ADMIN_EMAIL=                      # new-deposit and refund alerts
